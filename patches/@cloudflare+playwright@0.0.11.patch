diff --git a/lib/cjs/cloudflare/browser-error.cjs b/lib/cjs/cloudflare/browser-error.cjs
--- /dev/null
+++ b/lib/cjs/cloudflare/browser-error.cjs
@@ -0,0 +1,15 @@
+function createBrowserLaunchError(response, body) {
+  const headers = {};
+  for (const [name, value] of response.headers) {
+    if (/^(retry-after|ratelimit(?:-.*)?|x-ratelimit-.*|x-browser-ms-used|cf-ray|cf-brapi-error(?:-.*)?)$/i.test(name))
+      headers[name] = value;
+  }
+  return new Error(`Unable to create new browser: code: ${response.status}: message: ${body}`, {
+    cause: {
+      source: "cloudflare_browser_run", status: response.status, headers,
+      headerNames: Array.from(response.headers.keys())
+    }
+  });
+}
+
+exports.createBrowserLaunchError = createBrowserLaunchError;
