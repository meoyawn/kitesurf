{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kitesurf-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000000
  },
  "rules": [{ "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BrowserMCP"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PlaywrightMCP"
      ]
    },
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "PlaywrightMCP", "to": "BrowserMCP" }]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "716251",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_RATE_LIMIT",
      "namespace_id": "716253",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://localhost:8787"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
